<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#2E3239"
    tools:context=".register">

    <EditText
        android:id="@+id/info_email_register"
        android:layout_width="280dp"
        android:layout_height="46dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="#FFF"
        android:ems="10"
        android:inputType="textEmailAddress"
        android:textColor="#F2F2F2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/emailLoginID12" />

    <EditText
        android:id="@+id/txtUserName_insert"
        android:layout_width="280dp"
        android:layout_height="46dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="#FFF"
        android:ems="10"
        android:inputType="textEmailAddress"
        android:textColor="#F2F2F2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.503"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtUsername" />

    <TextView
        android:id="@+id/passLoginID8"
        android:layout_width="280dp"
        android:layout_height="25dp"
        android:layout_marginTop="16dp"
        android:fontFamily="monospace"
        android:text="@string/txt_password_login"
        android:textColor="#FFF"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.503"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtUserName_insert" />

    <TextView
        android:id="@+id/passLoginID9"
        android:layout_width="280dp"
        android:layout_height="25dp"
        android:layout_marginTop="16dp"
        android:fontFamily="monospace"
        android:text="@string/txt_psswd_retype"
        android:textColor="#FFF"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.503"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/info_passwd_register_retype" />

    <EditText
        android:id="@+id/info_passwd_register_retype"
        android:layout_width="280dp"
        android:layout_height="46dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="#FFF"
        android:ems="10"
        android:inputType="textPassword"
        android:textColor="#F2F2F2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.503"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/passLoginID8" />

    <EditText
        android:id="@+id/info_passwd_register_retype_"
        android:layout_width="280dp"
        android:layout_height="46dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="#FFF"
        android:ems="10"
        android:inputType="textPassword"
        android:textColor="#F2F2F2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.503"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/passLoginID9" />

    <TextView
        android:id="@+id/emailLoginID12"
        android:layout_width="280dp"
        android:layout_height="25dp"
        android:layout_marginTop="32dp"
        android:fontFamily="monospace"
        android:text="@string/txt_email_login"
        android:textColor="#FFF"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.496"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/profileIMG_" />

    <TextView
        android:id="@+id/txtUsername"
        android:layout_width="280dp"
        android:layout_height="25dp"
        android:layout_marginTop="16dp"
        android:fontFamily="monospace"
        android:text="@string/txt_user_name"
        android:textColor="#FFF"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.496"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/info_email_register" />

    <ImageView
        android:id="@+id/profileIMG_"
        android:layout_width="200dp"
        android:layout_height="120dp"
        android:layout_marginTop="64dp"
        android:clickable="true"
        android:src="@drawable/profile_default"
        android:visibility="visible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible" />

    <Button
        android:id="@+id/btn_Register_register"
        android:layout_width="250dp"
        android:layout_height="47dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="#26292B"
        android:text="@string/txt_register_button"
        android:textColor="#ffff"
        android:textColorLink="#ffff"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.496"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/info_passwd_register_retype_" />

</androidx.constraintlayout.widget.ConstraintLayout>